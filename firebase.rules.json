{
  "rules": {
    "strokes": {
      ".read": true,
      ".indexOn": ["t"],
      "$id": {
        ".write": "!data.exists() || (newData.val() == null && data.child('t').val() < now - 20000)",
        ".validate": "$id.matches(/^-[A-Za-z0-9_-]{19}$/) && newData.hasChildren(['t', 'c', 'p', 'cid'])",
        "t": { ".validate": "newData.isNumber() && newData.val() > now - 30000 && newData.val() < now + 10000" },
        "c": { ".validate": "newData.isString() && newData.val().length < 40" },
        "cid": { ".validate": "newData.isString() && newData.val().length < 24" },
        "p": {
          ".validate": "newData.hasChildren()",
          "$i": { ".validate": "$i.matches(/^(0|[1-9][0-9]{0,2})$/) && newData.isNumber() && newData.val() >= -1 && newData.val() <= 4" }
        },
        "$other": { ".validate": false }
      }
    },
    "wall": {
      ".read": true,
      ".indexOn": ["t"],
      "$id": {
        ".write": "!data.exists() || (newData.val() == null && (data.child('t').val() < now - 86400000 || data.child('t').val() > now - 60000))",
        ".validate": "$id.matches(/^-[A-Za-z0-9_-]{19}$/) && newData.hasChildren(['t', 'c', 'p'])",
        "t": { ".validate": "newData.isNumber() && newData.val() > now - 600000 && newData.val() < now + 10000" },
        "c": { ".validate": "newData.isString() && newData.val().length < 40" },
        "p": {
          ".validate": "newData.hasChildren()",
          "$i": { ".validate": "$i.matches(/^(0|[1-9][0-9]{0,2})$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" }
        },
        "$other": { ".validate": false }
      }
    },
    "notes": {
      ".read": true,
      ".indexOn": ["t"],
      "$id": {
        ".write": "!data.exists() || (newData.val() == null && root.child('noteKeys').child($id).exists() && root.child('noteProofs').child($id).exists() && root.child('noteProofs').child($id).val() == root.child('noteKeys').child($id).val())",
        ".validate": "$id.matches(/^-[A-Za-z0-9_-]{19}$/) && newData.hasChildren(['m', 't'])",
        "m": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 240" },
        "n": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "t": { ".validate": "newData.isNumber() && newData.val() > now - 15000 && newData.val() < now + 15000" },
        "c": { ".validate": "newData.isString() && newData.val().matches(/^(marker|rose|ink)$/)" },
        "$other": { ".validate": false }
      }
    },
    "noteKeys": {
      ".read": false,
      "$id": {
        ".write": "(!data.exists() && !root.child('notes').child($id).exists() && newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)) || (newData.val() == null && !root.child('notes').child($id).exists())"
      }
    },
    "noteProofs": {
      ".read": false,
      "$id": {
        ".write": "(newData.isString() && root.child('noteKeys').child($id).exists() && newData.val() == root.child('noteKeys').child($id).val()) || (newData.val() == null && !root.child('notes').child($id).exists())"
      }
    }
  }
}
